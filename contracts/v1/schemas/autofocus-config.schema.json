{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusir.local/contracts/v1/autofocus-config.schema.json",
  "title": "普通自动聚焦调速参数",
  "$defs": {
    "get": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slow_score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        }
      },
      "required": [
        "slow_score",
        "expected_revision"
      ]
    },
    "configuration": {
      "type": "object",
      "properties": {
        "slow_score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        }
      },
      "required": [
        "slow_score",
        "revision"
      ]
    }
  }
}
