<Window x:Class="FocusIR.Workbench.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新" Width="540" Height="380" MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI" ContentRendered="Window_ContentRendered">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="工作台更新" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{Binding UpdateStatusText}" Margin="0,12,0,16"
                   TextWrapping="Wrap" />
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="更新说明" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding AvailableUpdateReleaseNotes}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{Binding UpdateActionText}" Click="Update_Click"
                    Background="{StaticResource AccentBrush}" Foreground="White" />
            <Button Content="关闭" Click="Close_Click" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
