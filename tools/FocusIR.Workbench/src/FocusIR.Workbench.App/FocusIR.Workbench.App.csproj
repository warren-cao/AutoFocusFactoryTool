<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>FocusIR.Workbench</AssemblyName>
    <RootNamespace>FocusIR.Workbench.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FocusIR.Workbench.Domain\FocusIR.Workbench.Domain.csproj" />
    <ProjectReference Include="..\FocusIR.Workbench.Application\FocusIR.Workbench.Application.csproj" />
    <ProjectReference Include="..\FocusIR.Workbench.Infrastructure\FocusIR.Workbench.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\eng\keys\*.pem"
                      LogicalName="FocusIR.UpdateKeys.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
