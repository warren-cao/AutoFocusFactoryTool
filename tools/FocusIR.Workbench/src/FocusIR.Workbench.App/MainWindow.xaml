<Window x:Class="FocusIR.Workbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="clr-namespace:FocusIR.Workbench.App.Controls"
        Title="focusIR 自动聚焦工厂工作台" Height="760" Width="1080"
        MinHeight="600" MinWidth="900" Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="focusIR 工作台" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="设备连接与状态" Foreground="#647582" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="立即停止  (F12)" Click="Stop_Click" IsEnabled="{Binding CanStop}"
                        Visibility="{Binding StopButtonVisibility}" Background="#A83232" Foreground="White"
                        FontWeight="SemiBold" Padding="14,9" Margin="0,0,12,0"
                        ToolTip="发送软件停止请求；请人工确认双轴停稳。" />
                <Border Background="#E9EEF2" CornerRadius="14" Padding="12,7">
                    <TextBlock Text="v1 协议 · .NET 10 · Windows x64" Foreground="#455A68" />
                </Border>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding StateText}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="  ·  " Foreground="#9AA8B1" />
                    <TextBlock Text="{Binding DeviceIdentity}" FontSize="15" />
                    <Border Background="{Binding SourceBadgeBrush}" CornerRadius="10" Padding="9,4" Margin="12,0,0,0">
                        <TextBlock Text="{Binding SourceBadgeText}" FontSize="12" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding RoleText}" Foreground="#647582" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" MinWidth="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#D8E1E7" Cursor="SizeWE" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" ToolTip="左右拖动实时调整面板宽度" />
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="连接设备" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="设备地址" Foreground="#647582" />
                    <TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="TCP 端口" Foreground="#647582" Margin="0,10,0,0" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="工作台连接标识（自动发送）" Foreground="#647582" Margin="0,10,0,0" />
                    <TextBox Text="{Binding WorkbenchTag, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="连接" Click="Connect_Click" IsEnabled="{Binding CanConnect}" Background="{StaticResource AccentBrush}" Foreground="White" />
                        <Button Content="断开" Click="Disconnect_Click" IsEnabled="{Binding CanDisconnect}" />
                        <Button Content="刷新状态" Click="RefreshSnapshot_Click" IsEnabled="{Binding CanRefreshSnapshot}" />
                        <Button Content="读取温度" Click="ReadTemperature_Click" IsEnabled="{Binding CanReadTemperature}" />
                    </WrapPanel>
                    <Button Content="{Binding RequestStatusButtonText}" Click="QueryUncertainRequest_Click"
                            IsEnabled="{Binding CanQueryRequestStatus}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            ToolTip="只查询设备记录，不会重发原操作。" />
                    <StackPanel Visibility="{Binding ProfileControlsVisibility}" Margin="0,18,0,0">
                        <TextBlock Text="多物距标定配置" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="镜头型号" Foreground="#647582" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding LensModelCountText}" Foreground="#647582" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <ComboBox ItemsSource="{Binding LensModels}" SelectedItem="{Binding SelectedLensModel}" DisplayMemberPath="Label" IsEnabled="{Binding CanBrowseProfiles}" Margin="0,6,0,6"/>
                        <WrapPanel Margin="0,5,0,0">
                            <Button Content="激活镜头型号" Click="ActivateLensModel_Click" IsEnabled="{Binding CanActivateLensModel}" />
                            <Button Content="镜头初始化" Click="InitializeLens_Click" IsEnabled="{Binding CanInitializeLens}" />
                            <TextBlock Text="总预算（秒）" VerticalAlignment="Center" Margin="6,0,4,0" />
                            <TextBox Text="{Binding LensBudgetSeconds, UpdateSourceTrigger=PropertyChanged}" Width="48" ToolTip="镜头初始化预算为 1～600 秒，默认 180 秒；搜索范围不足时会逐步扩大。" />
                        </WrapPanel>
                        <TextBlock Text="默认 180 秒，最多 600 秒；目标保持在画面中央，完成后激活实测评分最高的物距。" TextWrapping="Wrap" Foreground="#647582" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ActiveLensStatus}" TextWrapping="Wrap" Foreground="#647582" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding LensInitializationStatus}" TextWrapping="Wrap" Foreground="#647582" Margin="0,4,0,6" />
                        <TextBlock Text="新镜头型号" Foreground="#647582"/>
                        <TextBox Text="{Binding NewLensModel, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBrowseProfiles}" MaxLength="100"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="新增镜头型号" Click="CreateLensModel_Click" IsEnabled="{Binding CanCreateLensModel}"/>
                            <Button Content="刷新配置" Click="RefreshProfiles_Click" IsEnabled="{Binding CanBrowseProfiles}"/>
                        </WrapPanel>
                        <TextBlock Text="该镜头的物距配置" Foreground="#647582" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding ProfileCountText}" Foreground="#647582" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Label" IsEnabled="{Binding CanBrowseProfiles}" Margin="0,6,0,6"/>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="新建物距" Click="NewProfile_Click" IsEnabled="{Binding CanCreateProfile}"/>
                            <Button Content="激活此物距" Click="ActivateProfile_Click" IsEnabled="{Binding CanActivateProfile}"/>
                            <Button Content="重新复验" Click="VerifyProfile_Click" IsEnabled="{Binding CanVerifyProfile}"/>
                            <Button Content="重新标定" Click="RecalibrateProfile_Click" IsEnabled="{Binding CanRecalibrateProfile}"/>
                        </WrapPanel>
                        <StackPanel Visibility="{Binding FactoryCalibrationEditorVisibility}" Margin="0,12,0,0">
                            <TextBlock Text="单物距工厂标定" FontSize="15" FontWeight="SemiBold" />
                        <StackPanel Visibility="{Binding FactoryCalibrationEditorVisibility}">
                            <TextBlock Text="物距配置名称（留空使用物距）" Foreground="#647582"/>
                            <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBrowseProfiles}" MaxLength="100"/>
                        </StackPanel>
                            <TextBlock Text="本次标定保存到上方所选镜头型号和物距配置。填写靶标和采样参数，版本信息由设备提供。"
                                       Foreground="#82919A" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <Border Background="#F2F5F7" CornerRadius="4" Padding="10" Margin="0,8,0,4">
                                <StackPanel>
                                    <TextBlock Text="镜头型号" Foreground="#647582" />
                                    <TextBlock Text="{Binding SelectedLensModel.Model}" TextWrapping="Wrap" Margin="0,3,0,6" />
                                    <TextBlock Text="固件版本（设备配置）" Foreground="#647582" />
                                    <TextBlock Text="{Binding FirmwareVersion}" TextWrapping="Wrap" Margin="0,3,0,6" />
                                    <TextBlock Text="清晰度指标版本（设备配置）" Foreground="#647582" />
                                    <TextBlock Text="{Binding ClarityMetricVersion}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="目标物距（m）" Foreground="#647582" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding FactoryTargetDistanceMeters, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="目标标识" Foreground="#647582" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding FactoryTargetIdentifier, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
                                    <TextBlock Text="每点有效帧数（1–7）" Foreground="#647582" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding FactorySampleCount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" Visibility="{Binding FactoryAdaptiveControlsVisibility}">
                                    <TextBlock Text="{Binding FactoryNodeLimitLabel}" Foreground="#647582" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding FactoryMaxNodes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4,0,0">
                                    <TextBlock Text="预算（ms）" Foreground="#647582" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding FactoryBudgetMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,4,0,0">
                                    <TextBlock Text="清晰范围参考比例" Foreground="#647582" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding FactoryClearScoreRatio, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,4,0,0">
                                    <TextBlock Text="环境温度（°C，可留空）" Foreground="#647582" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding FactoryAmbientTemperatureC, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <CheckBox Grid.Row="3" Grid.Column="2"
                                          IsChecked="{Binding FactoryBothDirections, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Bottom" Margin="0,0,0,5">
                                    <TextBlock Text="双向 wide↔tele" TextWrapping="Wrap" />
                                </CheckBox>
                            </Grid>
                            <WrapPanel Margin="0,6,0,0">
                                <StackPanel Width="140"><TextBlock Text="{Binding FactoryAcquisitionNodesLabel}" Foreground="#647582" TextWrapping="Wrap"/><TextBox Text="{Binding FactoryInitialNodes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <CheckBox Visibility="{Binding FactoryAdaptiveControlsVisibility}" Content="{Binding FactorySweepStrategyLabel}" IsChecked="{Binding FactoryUseHybrid}" VerticalAlignment="Bottom" Margin="8,0,0,6" ToolTip="{Binding FactorySweepStrategyDescription}"/>
                            </WrapPanel>
                            <TextBlock Visibility="{Binding FactorySingleSweepVisibility}" Text="每节点：粗扫（窗口不足时扩扫一次） → 一次局部精调 → 取最高分位置。" TextWrapping="Wrap" Foreground="#647582" Margin="0,6,0,0"/>
                            <StackPanel Margin="0,6,0,0" Visibility="{Binding FactorySweepGearVisibility}">
                                <TextBlock Text="FOCUS 扫焦档位（1–9）" Foreground="#647582" />
                                <TextBox Width="140" HorizontalAlignment="Left" Text="{Binding FactorySweepGear, UpdateSourceTrigger=PropertyChanged}" ToolTip="1为最低档。用于连续粗扫，不改变停稳精调速度；不再因扫焦速度超限拒绝标定。" />
                                <TextBlock Text="扫焦效果由操作人员评估，端点停止保护仍启用。" TextWrapping="Wrap" Foreground="#647582" />
                            </StackPanel>
                            <TextBlock Text="{Binding FactoryReadinessText}" Foreground="#647582"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="停稳由人工确认：请确认 ZOOM 和 FOCUS 轴停止后再点击启动。"
                                       Foreground="#647582" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Button Content="验证并开始单物距标定" Click="StartFactoryCalibration_Click"
                                    IsEnabled="{Binding CanStartFactoryCalibration}" Background="{StaticResource AccentBrush}"
                                    Foreground="White" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding FactoryCalibrationStatusText}" Foreground="#455A68"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding ProfileDetails}" TextWrapping="Wrap" Foreground="#455A68" Margin="0,5,0,4"/>
                        <TextBlock Text="先选择镜头型号，再选择物距配置。有有效模型时直接显示曲线；新增配置或点击重新标定后填写下方单物距标定参数，标定成功后保存。" TextWrapping="Wrap" Foreground="#647582"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding OperationControlsVisibility}" Margin="0,18,0,0">
                        <TextBlock Text="设备操作" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ControlLeaseText}" Foreground="#647582" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <WrapPanel Margin="-4,8,0,0">
                            <Button Content="获取操作权" Click="AcquireControl_Click" IsEnabled="{Binding CanAcquireControl}" />
                            <Button Content="释放操作权" Click="ReleaseControl_Click" IsEnabled="{Binding CanReleaseControl}" />
                            <Button Content="开始自动聚焦" Click="StartAutofocus_Click" IsEnabled="{Binding CanStartAutofocus}" />
                            <Button Content="查询任务" Click="RefreshTask_Click" IsEnabled="{Binding CanRefreshTask}" />
                            <Button Content="取消任务" Click="CancelTask_Click" IsEnabled="{Binding CanCancelTask}" />
                            <Button Content="读取 AF 结果" Click="ReadAutofocusResult_Click" IsEnabled="{Binding CanReadAutofocusResult}" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding AutofocusConfigurationVisibility}" Margin="0,7,0,3">
                            <TextBlock Text="自动聚焦减速清晰度阈值" Foreground="#647582"/>
                            <TextBox Text="{Binding AutofocusSlowScore, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditAutofocusConfiguration}" Margin="0,4,0,0"/>
                            <WrapPanel Margin="-4,4,0,0">
                                <Button Content="读取 AF 设置" Click="RefreshAutofocusConfiguration_Click" IsEnabled="{Binding CanRefreshAutofocusConfiguration}"/>
                                <Button Content="保存 AF 设置到设备" Click="SaveAutofocusConfiguration_Click" IsEnabled="{Binding CanSaveAutofocusConfiguration}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding AutofocusConfigurationStatus}" TextWrapping="Wrap" Foreground="#455A68" Margin="0,3,0,0"/>
                            <TextBlock Text="局部未找到有效焦点时扩大搜索；评分达到阈值后减速精调。默认 200，保存后断电保留。" TextWrapping="Wrap" Foreground="#647582" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AutofocusReadinessText}" Foreground="#647582" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AutofocusResultText}" Foreground="#455A68" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <StackPanel Visibility="{Binding TrackingControlsVisibility}" Margin="0,10,0,0">
                            <TextBlock Text="ZOOM—FOCUS 联动" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TrackingStatusText}" TextWrapping="Wrap" Foreground="#647582" Margin="0,4,0,4"/>
                            <TextBox Text="{Binding TrackingSpeedTableText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="135" VerticalScrollBarVisibility="Auto" Margin="0,2,0,5"/>
                            <StackPanel IsEnabled="{Binding CanEnableTracking}">
                                <CheckBox Content="启用倍率联动（保存到设备）" IsChecked="{Binding TrackingEnabled}" Margin="0,3,0,4"/>
                                <TextBlock Text="默认ZOOM档位（1～9，默认1）" Foreground="#647582"/>
                                <TextBox Text="{Binding TrackingDefaultGear, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="ZOOM档位1～9的FOCUS速度比例" Foreground="#647582" Margin="0,4,0,0"/>
                                <TextBox Text="{Binding TrackingSpeedRatios, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                                <TextBlock Text="依次填写九个比例，用逗号分隔。默认1；小于1减慢，大于1加快，范围0.1～3。手动ZOOM按请求速度持续运行，追焦不足请人工调速。停止联动不精修、不自动聚焦。" TextWrapping="Wrap" Foreground="#647582" FontSize="11" Margin="0,3,0,3"/>
                            </StackPanel>
                            <TextBlock Text="目标 ZOOM（raw）" Foreground="#647582"/>
                            <TextBox Text="{Binding TrackingZoomTarget, UpdateSourceTrigger=PropertyChanged}"/>
                            <WrapPanel Margin="-4,4,0,0">
                                <Button Content="刷新联动状态" Click="RefreshTracking_Click" IsEnabled="{Binding CanRefreshTracking}"/>
                                <Button Content="全程低速试运行" Click="VerifyTracking_Click" IsEnabled="{Binding CanVerifyTracking}"/>
                                <Button Content="保存联动设置" Click="EnableTracking_Click" IsEnabled="{Binding CanEnableTracking}"/>
                                <Button Content="联动到目标" Click="MoveTracking_Click" IsEnabled="{Binding CanMoveTracking}"/>
                                <Button Content="停止联动" Click="StopTracking_Click" IsEnabled="{Binding CanStopTracking}"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding SceneControlsVisibility}" Margin="0,6,0,0">
                            <TextBlock Text="场景初始化仅在设备公布能力、已有已验证基础模型并就绪时开放；设备受理不代表光学验收通过。"
                                       Foreground="#82919A" TextWrapping="Wrap" />
                            <WrapPanel Margin="-4,4,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <TextBlock Text="预算 ms" VerticalAlignment="Center" Foreground="#647582" />
                                    <TextBox Width="88" Text="{Binding SceneBudgetMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Content="获取场景租约" Click="AcquireSceneControl_Click" IsEnabled="{Binding CanAcquireSceneControl}" />
                                <Button Content="场景模型初始化（全行程）" Click="StartSceneInitialization_Click" IsEnabled="{Binding CanStartSceneInitialization}" />
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding JogCapabilityText}" Foreground="#82919A" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusNotice}" TextWrapping="Wrap" Foreground="#9B4B1C" Margin="0,12,0,0" />
                    <TextBlock Text="重连后不会恢复控制权或旧运动意图。启动 AF 需显式获取操作权，任务是否完成以设备终态为准。" TextWrapping="Wrap" Foreground="#647582" Margin="0,10,0,0" />
                    <TextBlock Text="设备端口 23233。连接时自动发送双方约定的工作台标识，无需填写凭据或令牌。" TextWrapping="Wrap" Foreground="#647582" Margin="0,9,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="设备摘要" FontSize="18" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,14,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,8,10">
                            <TextBlock Text="设备镜头型号" Foreground="#647582" />
                            <TextBlock Text="{Binding LensModel}" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="固件版本" Foreground="#647582" />
                            <TextBlock Text="{Binding FirmwareVersion}" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,8,0">
                            <TextBlock Text="清晰度指标版本" Foreground="#647582" />
                            <TextBlock Text="{Binding ClarityMetricVersion}" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="快照序号" Foreground="#647582" />
                            <TextBlock Text="{Binding SnapshotSequence}" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="设备实时状态" Foreground="#647582" />
                        <TextBlock DockPanel.Dock="Right" Text="只显示设备返回值；raw 是原始位置" Foreground="#82919A" FontSize="12" />
                    </DockPanel>
                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="机械状态" Foreground="#647582" />
                            <TextBlock Text="{Binding MechanicalStatus}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Text="图像状态" Foreground="#647582" />
                            <TextBlock Text="{Binding ImageStatus}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="控制租约" Foreground="#647582" />
                            <TextBlock Text="{Binding ControlStatus}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,8,0">
                            <TextBlock Text="ZOOM 轴" Foreground="#647582" />
                            <TextBlock Text="{Binding ZoomPosition}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="FOCUS 轴" Foreground="#647582" />
                            <TextBlock Text="{Binding FocusPosition}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="当前任务" Foreground="#647582" />
                            <TextBlock Text="{Binding TaskStatus}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,10,8,0">
                            <TextBlock Text="场景模型" Foreground="#647582" />
                            <TextBlock Text="{Binding SceneModelStatus}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,8,0">
                            <TextBlock Text="温度快照" Foreground="#647582" />
                            <TextBlock Text="{Binding TemperatureStatus}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
                            <TextBlock Text="设备故障" Foreground="#647582" />
                            <TextBlock Text="{Binding FaultStatus}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TabControl Grid.Row="4" SelectedIndex="{Binding MainSelectedTabIndex}">
                        <TabItem Header="状态日志">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="设备能力" Foreground="#647582" />
                        <TextBlock Grid.Row="1" Text="{Binding CapabilitySummary}" FontSize="15" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <ListBox Grid.Row="2" ItemsSource="{Binding RecentActivity}" BorderThickness="0" Background="#F7F9FA" />
                    </Grid>
                        </TabItem>
                        <TabItem Header="标定曲线"><charts:CalibrationChartsView DataContext="{Binding Charts}"/></TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
