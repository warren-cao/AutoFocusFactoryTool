<Window x:Class="FocusIR.Workbench.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于工作台" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI" ShowInTaskbar="False">
    <StackPanel Margin="28">
        <TextBlock Text="focusIR 工作台" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="自动聚焦工厂工作台" Foreground="#647582" Margin="0,6,0,20" />
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16">
            <StackPanel>
                <TextBlock Text="当前版本" Foreground="#647582" />
                <TextBlock x:Name="VersionText" FontSize="16" Margin="0,4,0,14" />
                <TextBlock Text="运行环境" Foreground="#647582" />
                <TextBlock Text=".NET 10 · Windows x64 · Socket v1 协议" Margin="0,4,0,14" />
                <TextBlock Text="Gitee 版本发布地址" Foreground="#647582" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://gitee.com/warren-cao/focusir-workbench-releases"
                               RequestNavigate="RepositoryLink_RequestNavigate">
                        https://gitee.com/warren-cao/focusir-workbench-releases
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
        <Button Content="关闭" Click="Close_Click" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,20,0,0" />
    </StackPanel>
</Window>
